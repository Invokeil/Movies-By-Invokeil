{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "invokeil-movies-api",
  "main": "src/worker.ts",
  "compatibility_date": "2025-01-01",
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "../out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "local-dev-cache"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "invokeil-images"
    }
  ]
}