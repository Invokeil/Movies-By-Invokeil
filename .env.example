# ── Movies by invokeil — environment template ───────────────────────────
# Copy to `.env` for local Next.js development. The static-export app
# itself needs NO keys in the browser — all provider credentials live in
# the Cloudflare Worker (provisioned via `wrangler secret put`).

# Local Prisma scratch DB (scaffold only — the app is local-first via IndexedDB)
DATABASE_URL="file:./db/custom.db"

# ── NEVER put real provider keys here for production. ──
# Production secrets are Worker secrets:
#   cd worker && wrangler secret put TMDB_API_TOKEN
#   cd worker && wrangler secret put OMDB_API_KEY
#   cd worker && wrangler secret put GEMINI_API_KEY
#   cd worker && wrangler secret put GROQ_API_KEY
#   cd worker && wrangler secret put TMDB_DEMO_KEY   # optional v3 fallback
